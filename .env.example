# Configurações do banco PostgreSQL
DB_HOST=seglicit_db.postgresql.dbaas.com.br
DB_PORT=5432
DB_NAME=seglicit_db
DB_USER=seglicit_db
DB_PASSWORD=L22190116r@!

# Configuração do Flask
FLASK_ENV=production
SECRET_KEY='asdf#FGSgvasgf$5$WGT'

# Automação PNCP (cron Railway)
SCRAPER_STATES=SP,RJ,MG,RS,PR,SC,BA,GO,DF
SCRAPER_LIMIT_PER_STATE=10
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_SECONDS=7200
SCRAPER_SKIP_SQLITE=true

# Email (Resend - https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Seglicit <noreply@seglicit.com.br>
FRONTEND_URL=https://seglicit.com.br
BACKEND_URL=https://web-production-684c4.up.railway.app

# Mercado Pago (assinaturas recorrentes)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Segredo fixo para ações HTTP do agente Zaia (header X-Seglicit-Agent-Secret)
# Gere um valor aleatório longo e use o mesmo na ação HTTP do agente na Zaia.
ZAIA_PLATFORM_SECRET=
# true = buscas do agente Zaia respeitam estados/áreas do plano; false = só filtros da query (padrão)
ZAIA_ENFORCE_PLAN=false

# Chat interno com IA (Claude) para busca de licitações — alternativa ao agente da Zaia
# Gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Notificações de novas licitações por email (true/false)
ENABLE_TENDER_EMAIL_NOTIFICATIONS=true
# Intervalo entre emails em segundos (Resend: máx. 5/s — use 0.25 ou mais)
EMAIL_RATE_LIMIT_DELAY=0.25
# Máximo de licitações listadas no corpo do email resumo (resto: link para plataforma)
DIGEST_MAX_ITEMS_IN_EMAIL=15